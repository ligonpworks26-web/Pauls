from mido import Message, MidiFile, MidiTrack, MetaMessage, bpm2tempo

midi = MidiFile()
track = MidiTrack()
midi.tracks.append(track)

# Tempo: 120 BPM
track.append(MetaMessage('set_tempo', tempo=bpm2tempo(120)))

# Program 0 = Acoustic Grand Piano
track.append(Message('program_change', program=0, time=0))

# MIDI note numbers
# D3 E3 F3 G3 A3 Bb3 C4 D4 ... D6
scale_up = [
    50, 52, 53, 55, 57, 58, 60, 62,
    64, 65, 67, 69, 70, 72, 74,
    76, 77, 79, 81, 82, 84, 86
]

scale_down = scale_up[-2::-1]  # D6 back to D3

full_scale = scale_up + scale_down

ticks_per_note = 480  # quarter note

for note in full_scale:
    # Apply -32 cents to every C
    if note % 12 == 0:  # C notes
        pitch_bend = int((-32 / 100) * 8192)
        lsb = (pitch_bend + 8192) & 0x7F
        msb = ((pitch_bend + 8192) >> 7) & 0x7F

        track.append(Message('pitchwheel',
                             pitch=pitch_bend,
                             time=0))

    track.append(Message('note_on', note=note, velocity=90, time=0))
    track.append(Message('note_off', note=note, velocity=64,
                         time=ticks_per_note))

    if note % 12 == 0:
        track.append(Message('pitchwheel', pitch=0, time=0))

midi.save("D_minor_3_octave_C_minus32cents.mid")

print("Saved: D_minor_3_octave_C_minus32cents.mid")
